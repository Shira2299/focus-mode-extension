{
  "manifest_version": 3,
  "name": "מצב ריכוז — חסימת הסחות דעת",
  "version": "1.0.0",
  "description": "בוחרים כרטיסייה אחת, קובעים טיימר ותוכנית, והתוסף חוסם את כל שאר הכרטיסיות והחלונות עד שמסיימים.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": ["lib/browser-api.js", "lib/state.js", "background.js"]
  },
  "permissions": ["tabs", "storage", "alarms", "scripting", "notifications", "windows"],
  "host_permissions": ["<all_urls>"],
  "browser_specific_settings": {
    "gecko": {
      "id": "focus-mode@local-extension",
      "strict_min_version": "109.0"
    }
  }
}
